<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuracion web de JeanPipi. -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" version="4.0">
  <display-name>JeanPipi</display-name>
  <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>
  <session-config>
    <session-timeout>60</session-timeout>
    <cookie-config><http-only>true</http-only></cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>
  <error-page><error-code>403</error-code><location>/403.jsp</location></error-page>
  <error-page><error-code>404</error-code><location>/404.jsp</location></error-page>
  <error-page><error-code>500</error-code><location>/500.jsp</location></error-page>
</web-app>
