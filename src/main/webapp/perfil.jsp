<%-- Pagina de perfil del usuario. --%>
<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="app-context" content="${pageContext.request.contextPath}"><title>Mi perfil | JEANPIPI</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css"></head><body>
<%@ include file="/WEB-INF/jspf/header.jspf" %>
<main class="container-xl account-page"><div class="page-heading"><p class="eyebrow">Cuenta</p><h1>Mi perfil</h1></div><div class="account-grid"><section class="panel-card"><h2>Datos personales</h2><form id="profileForm" class="stack-form"><label>Nombre<input id="profileName" required maxlength="120"></label><label>Correo<input id="profileEmail" type="email" required maxlength="190"></label><label>URL de avatar<input id="profileAvatar" type="url" maxlength="500"></label><label>Biografia<textarea id="profileBio" maxlength="1200"></textarea></label><div class="two-cols"><label>Instagram<input id="profileInstagram" maxlength="190"></label><label>X / Twitter<input id="profileTwitter" maxlength="190"></label></div><button class="editorial-button" type="submit">Guardar perfil</button><p id="profileMessage" class="form-message" role="status"></p></form></section><section class="panel-card"><h2>Seguridad</h2><form id="passwordForm" class="stack-form"><label>Contrasena actual<input id="currentPassword" type="password" required autocomplete="current-password"></label><label>Nueva contrasena<input id="newPassword" type="password" required minlength="10" autocomplete="new-password"></label><button class="outline-button" type="submit">Cambiar contrasena</button><p id="passwordMessage" class="form-message" role="status"></p></form></section></div></main>
<%@ include file="/WEB-INF/jspf/footer.jspf" %><script src="${pageContext.request.contextPath}/js/profile.js"></script></body></html>
