# Variables de entorno para produccion.
JEANPIPI_DB_URL=jdbc:postgresql://postgres:5432/jeanpipi
JEANPIPI_DB_USER=jeanpipi
JEANPIPI_DB_PASSWORD=change-me
JEANPIPI_DB_POOL_SIZE=12
JEANPIPI_BASE_URL=https://example.com
JEANPIPI_UPLOAD_DIR=/var/lib/jeanpipi/uploads
JEANPIPI_ADMIN_NAME=Administrador
JEANPIPI_ADMIN_EMAIL=admin@example.com
JEANPIPI_ADMIN_PASSWORD=change-me-now
JEANPIPI_SMTP_HOST=
JEANPIPI_SMTP_PORT=587
JEANPIPI_SMTP_USER=
JEANPIPI_SMTP_PASSWORD=
JEANPIPI_SMTP_FROM=no-reply@example.com
JEANPIPI_SMTP_TLS=true
